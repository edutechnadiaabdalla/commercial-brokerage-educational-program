            <h2 style="text-align: center !important;">بياناتك تملأ تلقائيا</h2>
            <form id="contactForm" action="https://formsubmit.co/8b64d44d1fa138de43d010102db7d1ab" method="POST">

                <div class="form-group">
                    <label for="name">الاسم:</label>
                    <input type="text" id="name" name="name"
                           value=""
                           placeholder="الاسم">
                </div>
                <div class="form-group">
                    <label for="email">البريد الإلكتروني:</label>
                    <input type="email" id="email" name="email"
                           value=""
                           placeholder="البريد الإلكتروني">
                </div>
                <div class="form-group">
                    <label for="message" style="direction:rtl; text-align:right;">الملخص:</label>
                    <textarea id="message" name="message" placeholder="اكتب هنا تلخيصك"></textarea>
                </div>
                <div class="centt">
                    <button style="align-content: center !important; align-items:center !important;" type="submit" class="btn">إرسال</button>
                    <button style="align-content: center !important; align-items:center !important;" type="reset" class="btn btn-secondary">مسح</button>
                </div>
            </form>
            <div class="message" id="formMessage"></div>
        </div>

