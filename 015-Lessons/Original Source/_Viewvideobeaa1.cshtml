    <script>
        const userName = "@User.FindFirst("name")?.Value";
        const userEmail = "@User.Identity.Name";

        console.log("بيانات من السيرفر:", {
            name: userName,
            email: userEmail,
            isAuthenticated: @User.Identity.IsAuthenticated.ToString().ToLower()
        });

        document.addEventListener('DOMContentLoaded', function () {
            if (!document.getElementById('name').value && userName) {
                document.getElementById('name').value = userName;
            }
            if (!document.getElementById('email').value && userEmail) {
                document.getElementById('email').value = userEmail;
            }
        });

        const contactForm = document.getElementById('contactForm');
        const formMessage = document.getElementById('formMessage');

        contactForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            const formData = new FormData(contactForm);

            try {
                formMessage.textContent = 'Sending your message...';
                formMessage.className = 'message';
                formMessage.style.display = 'block';

                const response = await fetch(contactForm.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'Accept': 'application/json'
                    }
                });

                if (response.ok) {
                    formMessage.textContent = 'شكرا لك! تم إرسال ملخصك بنجاح.';
                    formMessage.className = 'رسالة ناجحة';
                    contactForm.reset();
                } else {
                    throw new Error('Form submission failed');
                }
            } catch (error) {
                formMessage.textContent = 'خطأ في إرسال الملخص، حاول مرة أخرى!';
                formMessage.className = 'خطأ بإرسال الملخص';
            }
        });

    </script>


    <div class="spacing mt-5" style="height:10rem !important;"></div>
    <br />
    <br />
    <br />

    <!-- زر تبديل الخلفية -->
    <div class="theme-toggle">
        <button class="theme-btn light active" data-theme="light" title="الوضع الفاتح">☀️</button>
        <button class="theme-btn colorful" data-theme="colorful" title="الوضع الملون">🌈</button>
        <button class="theme-btn dark" data-theme="dark" title="الوضع الداكن">🌙</button>
    </div>

    <script>
        const themeButtons = document.querySelectorAll('.theme-btn');

        themeButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                const theme = this.getAttribute('data-theme');

                themeButtons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                document.body.className = `${theme}-theme`;

                localStorage.setItem('preferredTheme', theme);
            });
        });

        const savedTheme = localStorage.getItem('preferredTheme') || 'light';
        document.body.className = `${savedTheme}-theme`;
        themeButtons.forEach(btn => {
            if (btn.getAttribute('data-theme') === savedTheme) {
                btn.classList.add('active');
            }
        });
    </script>
    <script>
        const themeButtons = document.querySelectorAll('.theme-btn');

        const themeStyles = {
            light: {
                body: { background: '#f5f5f5', color: '#333' },
                container: { background: 'white', color: '#333' },
                examCard: { background: 'white', border: '1px solid #ddd' }
            },
            colorful: {
                body: {
                    background: 'linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%)',
                    color: '#2c3e50'
                },
                container: {
                    background: 'rgba(255, 255, 255, 0.9)',
                    color: '#2c3e50',
                    backdropFilter: 'blur(10px)'
                },
                examCard: {
                    background: 'linear-gradient(135deg, #6a11cb 0%, #2575fc 100%)',
                    color: 'white',
                    border: 'none'
                }
            },
            dark: {
                body: { background: '#121212', color: '#e0e0e0' },
                container: { background: '#1e1e1e', color: '#e0e0e0', border: '1px solid #333' },
                examCard: { background: '#2d2d2d', color: '#e0e0e0', border: '1px solid #444' }
            }
        };

        function applyThemeToAllElements(theme) {
            const styles = themeStyles[theme];

            Object.assign(document.body.style, styles.body);

            document.querySelectorAll('.container').forEach(container => {
                Object.assign(container.style, styles.container);
            });

            const examCard = document.querySelector('.exam-card');
            if (examCard) {
                Object.assign(examCard.style, styles.examCard);
            }

            if (theme === 'dark') {
                document.querySelectorAll('.exam-choice-btn').forEach(btn => {
                    btn.style.background = '#3d3d3d';
                    btn.style.color = '#e0e0e0';
                    btn.style.border = '1px solid #555';
                });

                document.querySelectorAll('.exam-feedback').forEach(feedback => {
                    feedback.style.background = '#333';
                    feedback.style.color = '#e0e0e0';
                    feedback.style.border = '1px solid #444';
                });
            }
        }

        themeButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                const theme = this.getAttribute('data-theme');

                themeButtons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                document.body.className = `${theme}-theme`;

                applyThemeToAllElements(theme);

                localStorage.setItem('preferredTheme', theme);
            });
        });

        const savedTheme = localStorage.getItem('preferredTheme') || 'light';
        document.body.className = `${savedTheme}-theme`;

        themeButtons.forEach(btn => {
            if (btn.getAttribute('data-theme') === savedTheme) {
                btn.classList.add('active');
            }
        });

        setTimeout(() => {
            applyThemeToAllElements(savedTheme);
        }, 100);
    </script>
    <script>
        const container = document.querySelector('.options-container');
        container.style.cssText = `
                    gap: 0px !important;
                    row-gap: 0px !important;
                    bottom: 80px !important;
                    padding: 3px !important;
                `;

        document.querySelectorAll('.option').forEach(opt => {
            opt.style.cssText = `
                        margin: 0 !important;
                        padding: 4px 2px !important;
                        min-height: 45px !important;
                    `;

            const top = opt.querySelector('.option-top');
            const bottom = opt.querySelector('.option-bottom');
            if (top) top.style.cssText = 'font-size:12px !important; margin:0 !important;';
            if (bottom) bottom.style.cssText = 'font-size:10px !important; margin:0 !important;';
        });
    </script>
