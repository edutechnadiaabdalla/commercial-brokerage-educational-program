<link rel="stylesheet" href="wwwroot/css/login.css" />
<script src="wwwroot/js/Login.js"></script>

<body>
    <section>
        <div class="login-box">
            <form id="account" method="post">

                <h2>تسجيل الدخول</h2>
                <br />
                <div class="remember-forget-centered">
                    <div class="input-box">
                        <span class="icon"><ion-icon name="mail-outline"></ion-icon></span>
                        <input type="email" asp-for="Input.Email" required placeholder=" ">
                        <label>البريد الإلكتروني</label>
                    </div>

                    <div class="input-box">
                        <span class="icon"><ion-icon name="lock-closed-outline"></ion-icon></span>
                        <span class="eye-toggle" onclick="togglePass()">
                            <ion-icon name="eye-outline" id="eyeIcon"></ion-icon>
                        </span>
                        <input type="password" id="passwordField" asp-for="Input.Password" required placeholder=" ">
                        <label>كلمة السر</label>
                    </div>

                    <div class="remember-forget">
                        <label class="remember-me">
                            <input type="checkbox" asp-for="Input.RememberMe" /> تذكر تسجيل دخولي
                        </label>
                        <a id="forgot-password" asp-page="./ForgotPassword">نسيت كلمة السر؟</a>
                    </div>
                </div>

                <br />

                <div>
                    <button id="login-submit" type="submit" class="boldy">تسجيل الدخول</button>
                </div>

                <div class="register-link">
                    <p>
                        ليس لديك حساب؟
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">تسجيل</a>
                    </p>
                </div>
            </form>
        </div>
        <div class="decoration decoration-1"></div>
        <div class="decoration decoration-2"></div>
        <div class="moving-spotlight"></div>
        <div class="particles" id="particles"></div>
    </section>
   
   <partial name="_ValidationScriptsPartial" />

    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <script>
        function togglePass() {
            const passwordField = document.getElementById("passwordField");
            const eyeIcon = document.getElementById("eyeIcon");
            if (passwordField.type === "password") {
                passwordField.type = "text";
                eyeIcon.setAttribute("name", "eye-off-outline");
            } else {
                passwordField.type = "password";
                eyeIcon.setAttribute("name", "eye-outline");
            }
        }
    </script>


</body>

<style>
    .input-box .form-control {
        background: transparent !important;
        color: #fff !important;
        border: none !important;
    }

        .input-box .form-control:hover {
            background: transparent !important;
            color: #fff !important;
            border: none !important;
        }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
        -webkit-text-fill-color: #fff !important;
        -webkit-box-shadow: 0 0 0px 1000px transparent inset !important;
        transition: background-color 5000s ease-in-out 0s;
    }

    .input-box {
        position: relative;
        width: 100%;
        height: 50px;
        border-bottom: 2px solid #fff;
        margin: 30px 0;
    }

        .input-box input {
            width: 100%;
            height: 100%;
            background: transparent !important;
            border: none !important;
            outline: none !important;
            font-size: 1em;
            color: #fff !important;
            padding: 0 35px 0 35px !important;
        }

    .remember-forget {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: -15px 0 15px;
        font-size: 0.9em;
        color: #fff;
    }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 5px;
        cursor: pointer;
    }

    .eye-toggle {
        position: absolute;
        left: 5px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        z-index: 10;
    }

    .input-box .icon {
        position: absolute;
        right: 5px;
        top: 50%;
        transform: translateY(-50%);
    }

    .remember-forget-centered {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin: 20px 0;
        width: 100%;
        color: #fff;
        font-size: 0.9em;
    }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .input-box input {
        background: transparent !important;
        border: none !important;
        padding: 0 40px !important;
        text-align: right !important;
    }

    .forgot-pass a {
        color: #00d2ff;
        text-decoration: none;
        transition: 0.3s;
    }

        .forgot-pass a:hover {
            text-shadow: 0 0 8px rgba(0, 210, 255, 0.8);
            text-decoration: underline;
        }

    .input-box {
        position: relative;
        width: 100%;
        height: 50px;
        margin: 30px 0;
        border: none !important;
    }
</style>
